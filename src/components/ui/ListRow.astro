---
interface Props {
  href: string
  title: string
  subtitle?: string
  meta?: string
  external?: boolean
  last?: boolean
}

const { href, title, subtitle, meta, external, last } = Astro.props
---

<a
  href={href}
  target={external ? '_blank' : undefined}
  rel={external ? 'noreferrer' : undefined}
  class:list={[
    'group flex min-h-[58px] items-center gap-3 px-3 py-2 transition-colors hover:bg-surface-elevated/60',
    !last && 'border-b border-surface-elevated',
  ]}
>
  <slot name="lead" />
  <span class="flex min-w-0 flex-1 flex-col gap-0.5">
    <span class="truncate text-md text-foreground">{title}</span>
    {subtitle && <span class="truncate text-xs text-muted">{subtitle}</span>}
  </span>
  {
    meta && (
      <span class="hidden shrink-0 whitespace-nowrap text-xs text-muted sm:block">
        {meta}
      </span>
    )
  }
  <span
    class="w-4 shrink-0 text-right text-base text-muted transition-colors group-hover:text-foreground"
    aria-hidden="true"
  >
    {external ? '↗' : '→'}
  </span>
</a>
