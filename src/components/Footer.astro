---
import { languageFromPath, withLocale } from '~/data/i18n'

const currentYear = new Date().getFullYear()
const lang = languageFromPath(Astro.url.pathname)
const labels =
  lang === 'de'
    ? {
        imprint: 'Impressum',
        privacy: 'Datenschutz',
        privacyPath: '/datenschutz',
        note: 'Alle genannten Marken und Logos sind Eigentum ihrer jeweiligen Inhaber. Die Nennung beschreibt vergangene freie Werkleistungen und impliziert keine aktuelle Geschäftsbeziehung.',
      }
    : {
        imprint: 'Imprint',
        privacy: 'Privacy',
        privacyPath: '/privacy',
        note: 'All trademarks and logos shown are the property of their respective owners. Mentions describe past freelance work and do not imply any ongoing business relationship.',
      }
---

<footer
  class="mt-10 flex flex-col gap-3 border-t border-border pt-5 text-xs text-muted"
>
  <div
    class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between"
  >
    <span>&copy; {currentYear} Patrick Wozniak</span>
    <slot />
    <div class="flex items-center gap-2.5">
      <a
        href={withLocale(lang, '/imprint')}
        class="transition-colors hover:text-foreground">{labels.imprint}</a
      >
      <span class="text-border" aria-hidden="true">|</span>
      <a
        href={withLocale(lang, labels.privacyPath)}
        class="transition-colors hover:text-foreground">{labels.privacy}</a
      >
      <span class="text-border" aria-hidden="true">|</span>
      <a
        href="mailto:hi@patwoz.de"
        class="transition-colors hover:text-foreground">hi@patwoz.de</a
      >
    </div>
  </div>
  <p class="text-2xs leading-4 text-faint">{labels.note}</p>
</footer>
