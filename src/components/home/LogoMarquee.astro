---
import type { Language } from '~/data/i18n'
import { clients } from '~/data/home'

interface Props {
  lang: Language
}

const { lang } = Astro.props
const items = clients(lang)
const label =
  lang === 'de'
    ? 'Unternehmen, für die ich als Freelancer gearbeitet habe'
    : 'Companies I have worked with as a freelancer'
/** Chip logos are drawn at 1.5× the list size so wordmarks stay legible. */
const scale = 1.5
---

<section class="logo-marquee -mx-5 sm:mx-0" aria-label={label}>
  <div class="logo-marquee__track flex w-max items-center gap-2.5 py-1">
    {
      [0, 1].map((copy) => (
        <ul
          class="flex shrink-0 items-center gap-2.5"
          aria-hidden={copy === 1 ? 'true' : undefined}
        >
          {items.map((client) => (
            <li class="shrink-0">
              <a
                href={client.href}
                target={client.external ? '_blank' : undefined}
                rel={client.external ? 'noreferrer' : undefined}
                tabindex={copy === 1 ? -1 : undefined}
                class="flex h-10 items-center rounded-sm border border-chip-border bg-chip px-3.5 transition-opacity hover:opacity-80"
                title={client.name}
              >
                <img
                  src={client.logo.src}
                  alt={client.logo.alt}
                  width={Math.round(client.logo.width * scale)}
                  height={Math.round(client.logo.height * scale)}
                  loading="lazy"
                  class="object-contain"
                  style={`width:${Math.round(client.logo.width * scale)}px;height:${Math.round(client.logo.height * scale)}px`}
                />
              </a>
            </li>
          ))}
        </ul>
      ))
    }
  </div>
</section>

<style>
  .logo-marquee {
    overflow: hidden;
    mask-image: linear-gradient(
      to right,
      transparent,
      black 48px,
      black calc(100% - 48px),
      transparent
    );
  }

  .logo-marquee__track {
    animation: logo-marquee 40s linear infinite;
  }

  .logo-marquee:hover .logo-marquee__track,
  .logo-marquee:focus-within .logo-marquee__track {
    animation-play-state: paused;
  }

  @keyframes logo-marquee {
    from {
      transform: translateX(0);
    }
    to {
      /* One copy plus the gap that separates the two copies. */
      transform: translateX(calc(-50% - 5px));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .logo-marquee {
      overflow-x: auto;
      mask-image: none;
    }

    .logo-marquee__track {
      animation: none;
      padding-inline: 1.25rem;
    }

    .logo-marquee__track > ul[aria-hidden] {
      display: none;
    }
  }
</style>
