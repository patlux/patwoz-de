---
import FieldRow from '~/components/ui/FieldRow.astro'
import type { Language } from '~/data/i18n'
import { homeCopy } from '~/data/home'

interface Props {
  lang: Language
}

const { lang } = Astro.props
const copy = homeCopy[lang]
---

<section class="flex flex-col gap-2.5" id="project">
  <h2 class="ui-label">{copy.projectLabel}</h2>
  <div class="ui-card">
    <div
      class="flex flex-col gap-1 border-b border-surface-elevated px-3 py-3.5"
    >
      <h3 class="text-md font-semibold text-foreground">{copy.projectTitle}</h3>
      <p class="text-sm leading-[18px] text-muted">{copy.projectBody}</p>
    </div>
    <FieldRow
      label={copy.projectWebsite}
      value="nuernberg-maps-review-removals.patwoz.dev"
      href="https://nuernberg-maps-review-removals.patwoz.dev/"
      kind="external"
    />
    <FieldRow
      label={copy.projectGithub}
      value="github.com/patlux/nuernberg-maps-review-removals"
      href="https://github.com/patlux/nuernberg-maps-review-removals"
      kind="external"
      last
    />
  </div>
</section>
