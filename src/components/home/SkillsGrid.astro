---
import SectionHeader from '~/components/ui/SectionHeader.astro'
import type { Language } from '~/data/i18n'
import { withLocale } from '~/data/i18n'
import { homeCopy, skills } from '~/data/home'

interface Props {
  lang: Language
}

const { lang } = Astro.props
const copy = homeCopy[lang]
---

<section class="flex flex-col gap-2.5" id="skills">
  <SectionHeader
    label={copy.skillsLabel}
    linkLabel={copy.skillsLink}
    linkHref={withLocale(lang, '/skills')}
  />
  <div class="ui-card">
    <div
      class="flex flex-col gap-0.5 border-b border-surface-elevated px-3 pb-2.5 pt-3"
    >
      <h2 class="text-md font-semibold text-foreground">{copy.skillsTitle}</h2>
      <p class="text-xs text-muted">{copy.skillsSubtitle}</p>
    </div>
    <ul class="grid grid-cols-2 sm:grid-cols-3">
      {
        skills.map((skill, index) => (
          <li
            class:list={[
              'border-surface-elevated',
              index % 2 === 0 && 'border-r',
              index % 3 !== 2 ? 'sm:border-r' : 'sm:border-r-0',
              index < skills.length - 2 && 'border-b',
              index < skills.length - 3 ? 'sm:border-b' : 'sm:border-b-0',
            ]}
          >
            <a
              href={withLocale(lang, skill.path)}
              class="group flex h-11 items-center justify-between px-3 text-base text-foreground transition-colors hover:bg-surface-elevated/60"
            >
              {skill.label}
              <span
                class="text-sm text-muted transition-colors group-hover:text-foreground"
                aria-hidden="true"
              >
                →
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
