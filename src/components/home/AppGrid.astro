---
import SectionHeader from '~/components/ui/SectionHeader.astro'
import type { Language } from '~/data/i18n'
import { withLocale } from '~/data/i18n'
import { apps, homeCopy } from '~/data/home'

interface Props {
  lang: Language
}

const { lang } = Astro.props
const copy = homeCopy[lang]
const items = apps(lang)
const openLabel = lang === 'de' ? 'Projekt ansehen' : 'Case study'
const externalLabel = lang === 'de' ? 'Link öffnen' : 'Open link'
---

<section class="flex flex-col gap-2.5" id="apps">
  <SectionHeader
    label={copy.appsLabel}
    title={copy.appsTitle}
    subtitle={copy.appsSubtitle}
    linkLabel={copy.appsLink}
    linkHref={withLocale(lang, '/work')}
  />
  <ul class="ui-card grid grid-cols-2 sm:grid-cols-4">
    {
      items.map((app, index) => (
        <li
          class:list={[
            'border-surface-elevated',
            index % 2 === 0 && 'border-r',
            index % 4 !== 3 ? 'sm:border-r' : 'sm:border-r-0',
            index < items.length - 2 && 'border-b',
            index < items.length - 4 ? 'sm:border-b' : 'sm:border-b-0',
          ]}
        >
          <a
            href={app.href}
            target={app.external ? '_blank' : undefined}
            rel={app.external ? 'noreferrer' : undefined}
            class="flex h-[60px] items-center gap-2.5 px-3 transition-colors hover:bg-surface-elevated/60"
            aria-label={`${app.name} – ${app.external ? externalLabel : openLabel}`}
          >
            <img
              src={app.icon}
              alt=""
              width="36"
              height="36"
              loading="lazy"
              class="h-9 w-9 shrink-0 rounded-md object-cover"
            />
            <span class="flex min-w-0 flex-col gap-0.5">
              <span class="truncate text-sm font-medium text-foreground">
                {app.name}
              </span>
              <span class="truncate text-2xs leading-[14px] text-muted">
                {app.description[lang]}
              </span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</section>
