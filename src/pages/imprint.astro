---
import Layout from '~/layouts/Layout.astro'
import BaseLayout from '~/components/BaseLayout.astro'
import Footer from '~/components/Footer.astro'
import ObfuscatedText from '~/components/ObfuscatedText.astro'
---

<Layout title="Imprint" lang="en">
  <BaseLayout>
    <a
      href="/"
      class="inline-flex items-center gap-2 text-sm text-warm-500 dark:text-warm-400 hover:text-warm-700 dark:hover:text-warm-300 transition-colors mb-8 group"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 20 20"
        fill="currentColor"
        class="w-4 h-4 group-hover:-translate-x-1 transition-transform"
      >
        <path
          fill-rule="evenodd"
          d="M17 10a.75.75 0 01-.75.75H5.612l4.158 3.96a.75.75 0 11-1.04 1.08l-5.5-5.25a.75.75 0 010-1.08l5.5-5.25a.75.75 0 111.04 1.08L5.612 9.25H16.25A.75.75 0 0117 10z"
          clip-rule="evenodd"></path>
      </svg>
      Back to home
    </a>

    <article class="animate-fade-in-up opacity-0">
      <h1
        class="text-3xl sm:text-4xl font-display font-bold text-warm-900 dark:text-warm-100"
      >
        Imprint
      </h1>
      <p class="text-warm-600 dark:text-warm-400 mt-2">
        Information pursuant to § 5 DDG (German Digital Services Act)
      </p>
      <p class="text-warm-500 dark:text-warm-500 mt-3 text-sm">
        The legally binding version of this imprint is the
        <a
          href="/de/imprint"
          class="text-accent-600 dark:text-accent-400 hover:underline"
          >German version</a
        >. This English version is provided for convenience.
      </p>

      <div class="mt-10 space-y-8">
        <div class="card-soft p-6">
          <div class="flex items-start gap-4">
            <div
              class="w-12 h-12 flex items-center justify-center bg-warm-100 dark:bg-dark-elevated rounded-xl flex-shrink-0"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="currentColor"
                class="w-6 h-6 text-accent-600 dark:text-accent-400"
              >
                <path
                  fill-rule="evenodd"
                  d="M4.5 2.25a.75.75 0 000 1.5v16.5h-.75a.75.75 0 000 1.5h16.5a.75.75 0 000-1.5h-.75V3.75a.75.75 0 000-1.5h-15zM9 6a.75.75 0 000 1.5h1.5a.75.75 0 000-1.5H9zm-.75 3.75A.75.75 0 019 9h1.5a.75.75 0 010 1.5H9a.75.75 0 01-.75-.75zM9 12a.75.75 0 000 1.5h1.5a.75.75 0 000-1.5H9zm3.75-5.25A.75.75 0 0113.5 6H15a.75.75 0 010 1.5h-1.5a.75.75 0 01-.75-.75zM13.5 9a.75.75 0 000 1.5H15A.75.75 0 0015 9h-1.5zm-.75 3.75a.75.75 0 01.75-.75H15a.75.75 0 010 1.5h-1.5a.75.75 0 01-.75-.75zM9 19.5v-2.25a.75.75 0 01.75-.75h4.5a.75.75 0 01.75.75v2.25a.75.75 0 01-.75.75h-4.5A.75.75 0 019 19.5z"
                  clip-rule="evenodd"></path>
              </svg>
            </div>
            <div class="flex-1">
              <h2
                class="text-lg font-semibold text-warm-900 dark:text-warm-100"
              >
                Operator of this website
              </h2>
              <div
                class="mt-3 text-warm-700 dark:text-warm-300 leading-relaxed"
              >
                <p class="font-medium">Patrick Wozniak</p>
                <div class="mt-2">
                  <ObfuscatedText
                    text={'c/o piparo.tech GmbH\nFrauentorgraben 61\n90443 Nürnberg\nGermany'}
                  />
                </div>
                <p class="mt-4 text-sm text-warm-600 dark:text-warm-400">
                  piparo.tech GmbH does not operate this website. The address is
                  used as a forwarding address only.
                </p>
              </div>
            </div>
          </div>
        </div>

        <div class="card-soft p-6">
          <div class="flex items-start gap-4">
            <div
              class="w-12 h-12 flex items-center justify-center bg-warm-100 dark:bg-dark-elevated rounded-xl flex-shrink-0"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="currentColor"
                class="w-6 h-6 text-accent-600 dark:text-accent-400"
              >
                <path
                  d="M1.5 8.67v8.58a3 3 0 003 3h15a3 3 0 003-3V8.67l-8.928 5.493a3 3 0 01-3.144 0L1.5 8.67z"
                ></path>
                <path
                  d="M22.5 6.908V6.75a3 3 0 00-3-3h-15a3 3 0 00-3 3v.158l9.714 5.978a1.5 1.5 0 001.572 0L22.5 6.908z"
                ></path>
              </svg>
            </div>
            <div class="flex-1">
              <h2
                class="text-lg font-semibold text-warm-900 dark:text-warm-100"
              >
                Contact
              </h2>
              <div class="mt-3 space-y-2">
                <a
                  href="mailto:hi@patwoz.de"
                  class="inline-flex items-center gap-2 text-accent-600 dark:text-accent-400 hover:text-accent-700 dark:hover:text-accent-300 transition-colors"
                >
                  hi@patwoz.de
                </a>
                <p
                  class="text-sm text-warm-600 dark:text-warm-400 leading-relaxed"
                >
                  Inquiries are typically answered within a few business days.
                </p>
              </div>
            </div>
          </div>
        </div>

        <div class="card-soft p-6">
          <div class="flex items-start gap-4">
            <div
              class="w-12 h-12 flex items-center justify-center bg-warm-100 dark:bg-dark-elevated rounded-xl flex-shrink-0"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="currentColor"
                class="w-6 h-6 text-accent-600 dark:text-accent-400"
              >
                <path
                  fill-rule="evenodd"
                  d="M9 4.5a.75.75 0 01.721.544l.813 2.846a3.75 3.75 0 002.576 2.576l2.846.813a.75.75 0 010 1.442l-2.846.813a3.75 3.75 0 00-2.576 2.576l-.813 2.846a.75.75 0 01-1.442 0l-.813-2.846a3.75 3.75 0 00-2.576-2.576l-2.846-.813a.75.75 0 010-1.442l2.846-.813A3.75 3.75 0 007.466 7.89l.813-2.846A.75.75 0 019 4.5z"
                  clip-rule="evenodd"></path>
              </svg>
            </div>
            <div class="flex-1">
              <h2
                class="text-lg font-semibold text-warm-900 dark:text-warm-100"
              >
                VAT
              </h2>
              <p
                class="mt-3 text-warm-700 dark:text-warm-300 leading-relaxed text-sm"
              >
                VAT identification number pursuant to § 27a UStG:<br />
                <span class="font-mono">DE347563380</span>
              </p>
            </div>
          </div>
        </div>

        <div class="card-soft p-6">
          <div class="flex items-start gap-4">
            <div
              class="w-12 h-12 flex items-center justify-center bg-warm-100 dark:bg-dark-elevated rounded-xl flex-shrink-0"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="currentColor"
                class="w-6 h-6 text-accent-600 dark:text-accent-400"
              >
                <path
                  fill-rule="evenodd"
                  d="M2.25 12c0-5.385 4.365-9.75 9.75-9.75s9.75 4.365 9.75 9.75-4.365 9.75-9.75 9.75S2.25 17.385 2.25 12zm8.706-1.442c1.146-.573 2.437.463 2.126 1.706l-.709 2.836.042-.02a.75.75 0 01.67 1.34l-.04.022c-1.147.573-2.438-.463-2.127-1.706l.71-2.836-.042.02a.75.75 0 11-.671-1.34l.041-.022zM12 9a.75.75 0 100-1.5.75.75 0 000 1.5z"
                  clip-rule="evenodd"></path>
              </svg>
            </div>
            <div class="flex-1">
              <h2
                class="text-lg font-semibold text-warm-900 dark:text-warm-100"
              >
                Responsible for editorial content
              </h2>
              <p
                class="mt-3 text-warm-700 dark:text-warm-300 leading-relaxed text-sm"
              >
                Responsible person within the meaning of § 18 (2) MStV (German
                Interstate Media Treaty): Patrick Wozniak, c/o piparo.tech GmbH,
                Frauentorgraben 61, 90443 Nürnberg, Germany.
              </p>
            </div>
          </div>
        </div>

        <div class="card-soft p-6">
          <div class="flex items-start gap-4">
            <div
              class="w-12 h-12 flex items-center justify-center bg-warm-100 dark:bg-dark-elevated rounded-xl flex-shrink-0"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="currentColor"
                class="w-6 h-6 text-accent-600 dark:text-accent-400"
              >
                <path
                  fill-rule="evenodd"
                  d="M12 1.5a5.25 5.25 0 00-5.25 5.25v3a3 3 0 00-3 3v6.75a3 3 0 003 3h10.5a3 3 0 003-3v-6.75a3 3 0 00-3-3v-3c0-2.9-2.35-5.25-5.25-5.25zm3.75 8.25v-3a3.75 3.75 0 10-7.5 0v3h7.5z"
                  clip-rule="evenodd"></path>
              </svg>
            </div>
            <div class="flex-1">
              <h2
                class="text-lg font-semibold text-warm-900 dark:text-warm-100"
              >
                Third-party trademarks and logos
              </h2>
              <p
                class="mt-3 text-warm-700 dark:text-warm-300 leading-relaxed text-sm"
              >
                All brand, product and company names as well as logos shown on
                this website are the property of their respective owners. They
                are used to describe past freelance work and do not imply any
                ongoing business relationship with, or endorsement by, the
                respective right holders.
              </p>
            </div>
          </div>
        </div>

        <div
          class="p-5 bg-warm-100 dark:bg-dark-elevated rounded-2xl border border-warm-200 dark:border-warm-800/50"
        >
          <p class="text-sm text-warm-600 dark:text-warm-400 leading-relaxed">
            <strong class="text-warm-700 dark:text-warm-300"
              >Liability disclaimer:</strong
            >
            The content of this website was created with care. However, no warranty
            is given for the accuracy, completeness or timeliness of the content.
            As a service provider, the operator is responsible for own content on
            these pages in accordance with § 7 (1) DDG and general law. No liability
            is assumed for external links pursuant to §§ 8 to 10 DDG.
          </p>
        </div>

        <div
          class="p-5 bg-warm-100 dark:bg-dark-elevated rounded-2xl border border-warm-200 dark:border-warm-800/50"
        >
          <p class="text-sm text-warm-600 dark:text-warm-400 leading-relaxed">
            <strong class="text-warm-700 dark:text-warm-300"
              >Dispute resolution:</strong
            >
            The operator is neither willing nor obliged to participate in dispute
            resolution proceedings before a consumer arbitration body (§ 36 VSBG).
            The European Commission provides a platform for online dispute resolution:
            <a
              href="https://ec.europa.eu/consumers/odr"
              target="_blank"
              rel="noopener noreferrer"
              class="text-accent-600 dark:text-accent-400 hover:underline"
              >ec.europa.eu/consumers/odr</a
            >.
          </p>
        </div>
      </div>
    </article>

    <Footer />
  </BaseLayout>
</Layout>
