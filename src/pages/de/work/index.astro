---
import Layout from '~/layouts/Layout.astro'
import BaseLayout from '~/components/BaseLayout.astro'
import Footer from '~/components/Footer.astro'
import ClientMarquee from '~/components/ClientMarquee.astro'

const appCaseStudies = [
  {
    name: 'Glowing Blox',
    href: '/de/work/glowing-blox',
    icon: '/apps/glowing-blox.png',
    description:
      'Ein lokales und online spielbares Strategiespiel mit Mobile-App, Multiplayer, Backend und Web.',
  },
  {
    name: 'Goory',
    href: '/de/work/goory',
    icon: '/apps/goory.jpg',
    description:
      'Eine Plattform für lokale Produkte mit Mobile-App, CMS, Backend und Delivery.',
  },
  {
    name: 'Yuu Yoga',
    href: '/de/work/yuuyoga',
    icon: '/apps/yuu-yoga.jpg',
    description:
      'Mobile Produktarbeit an der geführten Yoga-App von Porsche Digital.',
  },
  {
    name: 'GreenSP',
    href: '/de/work/greensp',
    icon: '/apps/greensp.png',
    description: 'Eine fokussierte Mobile-App für Vertriebspartner von Ranger.',
  },
  {
    name: 'ME SENSE',
    href: '/de/work/me-sense',
    icon: '/apps/me-sense.jpg',
    description: 'Die Weatherdock Mobile-App zur Fernüberwachung von Booten.',
  },
]
---

<Layout
  title="Referenzen"
  description="Kundenprojekte, eigene Produkte und Highlights aus Mobile, Web und Platform Engineering."
  lang="de"
>
  <BaseLayout>
    <section class="animate-fade-in-up opacity-0">
      <h1
        class="text-3xl sm:text-4xl font-display font-bold text-warm-900 dark:text-warm-100"
      >
        Kundenprojekte
      </h1>
      <p class="text-lg text-warm-600 dark:text-warm-400 mt-3 leading-relaxed">
        Ausgewählte Kundenprojekte und eigene Produkte. Jedes Projekt zeigt
        einen anderen Teil meiner Erfahrung in Mobile, Web und Platform
        Engineering.
      </p>
    </section>

    <div class="grid gap-5 mt-10">
      <a
        href="/de/work/piparo-party"
        class="card-soft p-6 group hover-lift animate-fade-in-up opacity-0 stagger-1"
      >
        <div class="flex flex-col sm:flex-row gap-6">
          <div
            class="flex-shrink-0 flex items-center justify-center w-full sm:w-32 h-24 bg-[#15172a] rounded-xl transition-colors"
            data-vt="logo"
          >
            <img
              src="/company/piparo-party.webp"
              alt="piparo.party App-Icon"
              width="72"
              height="72"
              class="rounded-xl"
            />
          </div>
          <div class="flex-1">
            <h3
              class="text-lg font-semibold text-warm-900 dark:text-warm-100 group-hover:text-accent-600 dark:group-hover:text-accent-400 transition-colors"
            >
              piparo.party
            </h3>
            <p class="text-warm-600 dark:text-warm-400 mt-2 leading-relaxed">
              Eigenentwicklung einer offlinefähigen Partyspiel-App mit 25
              Spielen, 22 Sprachen, nativen Abos, mehrsprachiger Website und
              wachsender lokaler Multiplayer-Plattform.
            </p>
            <div class="flex flex-wrap gap-2 mt-4">
              <span
                class="px-2.5 py-1 text-xs font-medium bg-warm-200 dark:bg-warm-800/40 text-warm-700 dark:text-warm-300 rounded-lg"
              >
                React Native
              </span>
              <span
                class="px-2.5 py-1 text-xs font-medium bg-warm-200 dark:bg-warm-800/40 text-warm-700 dark:text-warm-300 rounded-lg"
              >
                Expo
              </span>
              <span
                class="px-2.5 py-1 text-xs font-medium bg-warm-200 dark:bg-warm-800/40 text-warm-700 dark:text-warm-300 rounded-lg"
              >
                TypeScript
              </span>
              <span
                class="px-2.5 py-1 text-xs font-medium bg-warm-200 dark:bg-warm-800/40 text-warm-700 dark:text-warm-300 rounded-lg"
              >
                Produktentwicklung
              </span>
            </div>
          </div>
          <div
            class="flex-shrink-0 flex items-center text-warm-400 group-hover:text-accent-500 transition-colors"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="2"
              stroke="currentColor"
              class="w-5 h-5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="m8.25 4.5 7.5 7.5-7.5 7.5"></path>
            </svg>
          </div>
        </div>
      </a>

      <a
        href="/de/work/porsche"
        class="card-soft p-6 group hover-lift animate-fade-in-up opacity-0 stagger-2"
      >
        <div class="flex flex-col sm:flex-row gap-6">
          <div
            class="flex-shrink-0 flex items-center justify-center w-full sm:w-32 h-24 bg-warm-100 dark:bg-dark-elevated rounded-xl group-hover:bg-warm-200 dark:group-hover:bg-warm-800/30 transition-colors"
            data-vt="logo"
          >
            <img
              src="/company/Porsche-Logo.webp"
              alt="Porsche Logo"
              width="80"
              height="46"
              class="opacity-90"
            />
          </div>
          <div class="flex-1">
            <h3
              class="text-lg font-semibold text-warm-900 dark:text-warm-100 group-hover:text-accent-600 dark:group-hover:text-accent-400 transition-colors"
            >
              Porsche Digital
            </h3>
            <p class="text-warm-600 dark:text-warm-400 mt-2 leading-relaxed">
              Fullstack-Beiträge zu einer Consumer-Mobile-App mit Live-Video,
              In-App-Abos und serverlosem AWS-Backend.
            </p>
            <div class="flex flex-wrap gap-2 mt-4">
              <span
                class="px-2.5 py-1 text-xs font-medium bg-warm-200 dark:bg-warm-800/40 text-warm-700 dark:text-warm-300 rounded-lg"
              >
                React Native
              </span>
              <span
                class="px-2.5 py-1 text-xs font-medium bg-warm-200 dark:bg-warm-800/40 text-warm-700 dark:text-warm-300 rounded-lg"
              >
                AWS CDK
              </span>
              <span
                class="px-2.5 py-1 text-xs font-medium bg-warm-200 dark:bg-warm-800/40 text-warm-700 dark:text-warm-300 rounded-lg"
              >
                TypeScript
              </span>
              <span
                class="px-2.5 py-1 text-xs font-medium bg-warm-200 dark:bg-warm-800/40 text-warm-700 dark:text-warm-300 rounded-lg"
              >
                Fullstack
              </span>
            </div>
          </div>
          <div
            class="flex-shrink-0 flex items-center text-warm-400 group-hover:text-accent-500 transition-colors"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="2"
              stroke="currentColor"
              class="w-5 h-5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="m8.25 4.5 7.5 7.5-7.5 7.5"></path>
            </svg>
          </div>
        </div>
      </a>

      <a
        href="/de/work/kulturpass"
        class="card-soft p-6 group hover-lift animate-fade-in-up opacity-0 stagger-3"
      >
        <div class="flex flex-col sm:flex-row gap-6">
          <div
            class="flex-shrink-0 flex items-center justify-center w-full sm:w-32 h-24 bg-warm-100 dark:bg-dark-elevated rounded-xl group-hover:bg-warm-200 dark:group-hover:bg-warm-800/30 transition-colors"
            data-vt="logo"
          >
            <img
              src="/company/sap.svg"
              alt="SAP Logo"
              width="80"
              height="40"
              class="opacity-90"
            />
          </div>
          <div class="flex-1">
            <h3
              class="text-lg font-semibold text-warm-900 dark:text-warm-100 group-hover:text-accent-600 dark:group-hover:text-accent-400 transition-colors"
            >
              SAP / KulturPass DE
            </h3>
            <p class="text-warm-600 dark:text-warm-400 mt-2 leading-relaxed">
              Mitgewirkt an der KulturPass Mobile-App, einer Bundesinitiative
              mit Kulturbudget für 18-Jährige.
            </p>
            <div class="flex flex-wrap gap-2 mt-4">
              <span
                class="px-2.5 py-1 text-xs font-medium bg-warm-200 dark:bg-warm-800/40 text-warm-700 dark:text-warm-300 rounded-lg"
              >
                React Native
              </span>
              <span
                class="px-2.5 py-1 text-xs font-medium bg-warm-200 dark:bg-warm-800/40 text-warm-700 dark:text-warm-300 rounded-lg"
              >
                Redux Toolkit
              </span>
              <span
                class="px-2.5 py-1 text-xs font-medium bg-warm-200 dark:bg-warm-800/40 text-warm-700 dark:text-warm-300 rounded-lg"
              >
                TypeScript
              </span>
              <span
                class="px-2.5 py-1 text-xs font-medium bg-warm-200 dark:bg-warm-800/40 text-warm-700 dark:text-warm-300 rounded-lg"
              >
                DevOps
              </span>
            </div>
          </div>
          <div
            class="flex-shrink-0 flex items-center text-warm-400 group-hover:text-accent-500 transition-colors"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="2"
              stroke="currentColor"
              class="w-5 h-5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="m8.25 4.5 7.5 7.5-7.5 7.5"></path>
            </svg>
          </div>
        </div>
      </a>

      <a
        href="/de/work/stroeer"
        class="card-soft p-6 group hover-lift animate-fade-in-up opacity-0 stagger-4"
      >
        <div class="flex flex-col sm:flex-row gap-6">
          <div
            class="flex-shrink-0 flex items-center justify-center w-full sm:w-32 h-24 bg-warm-100 dark:bg-dark-elevated rounded-xl group-hover:bg-warm-200 dark:group-hover:bg-warm-800/30 transition-colors"
            data-vt="logo"
          >
            <div class="flex flex-col items-center gap-1">
              <img
                src="/company/str-logo-white.svg"
                alt="Ströer Logo"
                width="80"
                height="17"
                class="opacity-90 dark:invert"
              />
              <img
                src="/company/t-online-desktop.327ab976.svg"
                alt="t-online Logo"
                width="60"
                height="13"
                class="opacity-90 dark:invert"
              />
            </div>
          </div>
          <div class="flex-1">
            <h3
              class="text-lg font-semibold text-warm-900 dark:text-warm-100 group-hover:text-accent-600 dark:group-hover:text-accent-400 transition-colors"
            >
              Ströer / t-online
            </h3>
            <p class="text-warm-600 dark:text-warm-400 mt-2 leading-relaxed">
              Mitgewirkt an der t-online News-App auf Basis von React Native und
              Expo, u.a. an Navigation, Suche, Push und Monetarisierung.
            </p>
            <div class="flex flex-wrap gap-2 mt-4">
              <span
                class="px-2.5 py-1 text-xs font-medium bg-warm-200 dark:bg-warm-800/40 text-warm-700 dark:text-warm-300 rounded-lg"
              >
                React Native
              </span>
              <span
                class="px-2.5 py-1 text-xs font-medium bg-warm-200 dark:bg-warm-800/40 text-warm-700 dark:text-warm-300 rounded-lg"
              >
                Expo
              </span>
              <span
                class="px-2.5 py-1 text-xs font-medium bg-warm-200 dark:bg-warm-800/40 text-warm-700 dark:text-warm-300 rounded-lg"
              >
                TypeScript
              </span>
              <span
                class="px-2.5 py-1 text-xs font-medium bg-warm-200 dark:bg-warm-800/40 text-warm-700 dark:text-warm-300 rounded-lg"
              >
                DevOps
              </span>
            </div>
          </div>
          <div
            class="flex-shrink-0 flex items-center text-warm-400 group-hover:text-accent-500 transition-colors"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="2"
              stroke="currentColor"
              class="w-5 h-5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="m8.25 4.5 7.5 7.5-7.5 7.5"></path>
            </svg>
          </div>
        </div>
      </a>

      <a
        href="/de/work/abl"
        class="card-soft p-6 group hover-lift animate-fade-in-up opacity-0 stagger-5"
      >
        <div class="flex flex-col sm:flex-row gap-6">
          <div
            class="flex-shrink-0 flex items-center justify-center w-full sm:w-32 h-24 bg-warm-100 dark:bg-dark-elevated rounded-xl group-hover:bg-warm-200 dark:group-hover:bg-warm-800/30 transition-colors"
            data-vt="logo"
          >
            <img
              src="/company/abl.svg"
              alt="ABL Logo"
              width="80"
              height="32"
              class="opacity-90 dark:invert"
            />
          </div>
          <div class="flex-1">
            <h3
              class="text-lg font-semibold text-warm-900 dark:text-warm-100 group-hover:text-accent-600 dark:group-hover:text-accent-400 transition-colors"
            >
              ABL
            </h3>
            <p class="text-warm-600 dark:text-warm-400 mt-2 leading-relaxed">
              Mitgewirkt an der ABL Configuration App für EV-Wallbox-Setup und
              -Management, u.a. an Gerätekommunikation über WiFi/Bluetooth,
              Firmware-Updates und Mehrsprachigkeit.
            </p>
            <div class="flex flex-wrap gap-2 mt-4">
              <span
                class="px-2.5 py-1 text-xs font-medium bg-warm-200 dark:bg-warm-800/40 text-warm-700 dark:text-warm-300 rounded-lg"
              >
                React Native
              </span>
              <span
                class="px-2.5 py-1 text-xs font-medium bg-warm-200 dark:bg-warm-800/40 text-warm-700 dark:text-warm-300 rounded-lg"
              >
                MobX
              </span>
              <span
                class="px-2.5 py-1 text-xs font-medium bg-warm-200 dark:bg-warm-800/40 text-warm-700 dark:text-warm-300 rounded-lg"
              >
                TypeScript
              </span>
              <span
                class="px-2.5 py-1 text-xs font-medium bg-warm-200 dark:bg-warm-800/40 text-warm-700 dark:text-warm-300 rounded-lg"
              >
                IoT
              </span>
            </div>
          </div>
          <div
            class="flex-shrink-0 flex items-center text-warm-400 group-hover:text-accent-500 transition-colors"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="2"
              stroke="currentColor"
              class="w-5 h-5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="m8.25 4.5 7.5 7.5-7.5 7.5"></path>
            </svg>
          </div>
        </div>
      </a>

      <a
        href="/de/work/ibm"
        class="card-soft p-6 group hover-lift animate-fade-in-up opacity-0 stagger-6"
      >
        <div class="flex flex-col sm:flex-row gap-6">
          <div
            class="flex-shrink-0 flex items-center justify-center w-full sm:w-32 h-24 bg-warm-100 dark:bg-dark-elevated rounded-xl group-hover:bg-warm-200 dark:group-hover:bg-warm-800/30 transition-colors"
            data-vt="logo"
          >
            <div class="flex flex-col items-center gap-2">
              <img
                src="/company/IBM_logo.svg"
                alt="IBM Logo"
                width="50"
                height="20"
                class="opacity-90"
              />
              <img
                src="/company/barmer.svg"
                alt="Barmer Logo"
                width="60"
                height="16"
                class="opacity-90"
              />
            </div>
          </div>
          <div class="flex-1">
            <h3
              class="text-lg font-semibold text-warm-900 dark:text-warm-100 group-hover:text-accent-600 dark:group-hover:text-accent-400 transition-colors"
            >
              IBM iX / Barmer
            </h3>
            <p class="text-warm-600 dark:text-warm-400 mt-2 leading-relaxed">
              Frontend-Arbeit über IBM iX für Barmer, eine der größten
              gesetzlichen Krankenversicherungen Deutschlands, u.a. an Modulen
              der Barmer App und einem Cross-Platform-Designsystem.
            </p>
            <div class="flex flex-wrap gap-2 mt-4">
              <span
                class="px-2.5 py-1 text-xs font-medium bg-warm-200 dark:bg-warm-800/40 text-warm-700 dark:text-warm-300 rounded-lg"
              >
                React Native
              </span>
              <span
                class="px-2.5 py-1 text-xs font-medium bg-warm-200 dark:bg-warm-800/40 text-warm-700 dark:text-warm-300 rounded-lg"
              >
                React
              </span>
              <span
                class="px-2.5 py-1 text-xs font-medium bg-warm-200 dark:bg-warm-800/40 text-warm-700 dark:text-warm-300 rounded-lg"
              >
                TypeScript
              </span>
              <span
                class="px-2.5 py-1 text-xs font-medium bg-warm-200 dark:bg-warm-800/40 text-warm-700 dark:text-warm-300 rounded-lg"
              >
                Design System
              </span>
            </div>
          </div>
          <div
            class="flex-shrink-0 flex items-center text-warm-400 group-hover:text-accent-500 transition-colors"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="2"
              stroke="currentColor"
              class="w-5 h-5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="m8.25 4.5 7.5 7.5-7.5 7.5"></path>
            </svg>
          </div>
        </div>
      </a>

      <a
        href="/de/work/kicker"
        class="card-soft p-6 group hover-lift animate-fade-in-up opacity-0 stagger-6"
      >
        <div class="flex flex-col sm:flex-row gap-6">
          <div
            class="flex-shrink-0 flex items-center justify-center w-full sm:w-32 h-24 bg-warm-100 dark:bg-dark-elevated rounded-xl group-hover:bg-warm-200 dark:group-hover:bg-warm-800/30 transition-colors"
            data-vt="logo"
          >
            <img
              src="/company/kicker.svg"
              alt="Kicker Logo"
              width="80"
              height="32"
              class="opacity-90"
            />
          </div>
          <div class="flex-1">
            <h3
              class="text-lg font-semibold text-warm-900 dark:text-warm-100 group-hover:text-accent-600 dark:group-hover:text-accent-400 transition-colors"
            >
              Olympia Verlag (Kicker)
            </h3>
            <p class="text-warm-600 dark:text-warm-400 mt-2 leading-relaxed">
              Fullstack-Arbeit an FWMFL, einer Podcast- und Audiobook-
              Streaming-Plattform für Fußballfans, über Mobile,
              Backend-Services, Website und Kubernetes-Infrastruktur.
            </p>
            <div class="flex flex-wrap gap-2 mt-4">
              <span
                class="px-2.5 py-1 text-xs font-medium bg-warm-200 dark:bg-warm-800/40 text-warm-700 dark:text-warm-300 rounded-lg"
              >
                React Native
              </span>
              <span
                class="px-2.5 py-1 text-xs font-medium bg-warm-200 dark:bg-warm-800/40 text-warm-700 dark:text-warm-300 rounded-lg"
              >
                Go / Rust
              </span>
              <span
                class="px-2.5 py-1 text-xs font-medium bg-warm-200 dark:bg-warm-800/40 text-warm-700 dark:text-warm-300 rounded-lg"
              >
                Kubernetes
              </span>
              <span
                class="px-2.5 py-1 text-xs font-medium bg-warm-200 dark:bg-warm-800/40 text-warm-700 dark:text-warm-300 rounded-lg"
              >
                Fullstack
              </span>
            </div>
          </div>
          <div
            class="flex-shrink-0 flex items-center text-warm-400 group-hover:text-accent-500 transition-colors"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="2"
              stroke="currentColor"
              class="w-5 h-5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="m8.25 4.5 7.5 7.5-7.5 7.5"></path>
            </svg>
          </div>
        </div>
      </a>
    </div>

    <section class="mt-16 animate-fade-in-up opacity-0 stagger-6">
      <div class="max-w-2xl">
        <h2
          class="text-2xl font-display font-bold text-warm-900 dark:text-warm-100"
        >
          Weitere App-Referenzen
        </h2>
        <p class="mt-2 text-warm-600 dark:text-warm-400 leading-relaxed">
          Weitere Mobile-Produkte – von piparo.tech Projekten bis zu
          fokussierten Kundenaufträgen.
        </p>
      </div>

      <div
        class="mt-6 overflow-hidden rounded-lg border border-warm-200 bg-white dark:border-warm-800 dark:bg-dark-surface"
      >
        {
          appCaseStudies.map((project) => (
            <a
              href={project.href}
              class="ledger-hover-cell flex min-h-28 items-center gap-4 border-b border-warm-200 p-5 last:border-b-0 dark:border-warm-800"
            >
              <img
                src={project.icon}
                data-vt="logo"
                alt={`${project.name} App-Icon`}
                width="64"
                height="64"
                class="h-16 w-16 flex-shrink-0 rounded-xl object-cover ring-1 ring-black/10 dark:ring-white/10"
              />
              <span class="min-w-0 flex-1">
                <span class="block font-semibold text-warm-900 dark:text-warm-100">
                  {project.name}
                </span>
                <span class="mt-1 block text-sm leading-relaxed text-warm-600 dark:text-warm-400">
                  {project.description}
                </span>
              </span>
              <span
                aria-hidden="true"
                class="ledger-hover-arrow text-warm-400 dark:text-warm-500"
              >
                →
              </span>
            </a>
          ))
        }
      </div>
    </section>

    <ClientMarquee />

    <Footer />
  </BaseLayout>
</Layout>
