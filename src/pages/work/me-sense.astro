---
import Layout from '~/layouts/Layout.astro'
import BaseLayout from '~/components/BaseLayout.astro'
import Footer from '~/components/Footer.astro'
import AppStoreLinks from '~/components/AppStoreLinks.astro'

const pageTitle = 'ME SENSE'
const description =
  'Contributed to the ME SENSE mobile app for remote boat monitoring, a Weatherdock AG product.'
const canonicalURL = new URL(Astro.url.pathname, Astro.site)
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: Astro.site?.toString() || 'https://patwoz.dev',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Work',
      item: new URL('/work', Astro.site).toString(),
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: pageTitle,
      item: canonicalURL.toString(),
    },
  ],
}
---

<Layout
  title="ME SENSE - Work"
  description={description}
  image="https://patwoz.dev/apps/me-sense.jpg"
>
  <BaseLayout>
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(breadcrumbSchema)}
    />
    <article>
      <a
        href="/work"
        class="inline-flex items-center gap-1 text-sm text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-300 mb-6"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
          class="w-4 h-4"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M15.75 19.5 8.25 12l7.5-7.5"></path>
        </svg>
        Back to Work
      </a>

      <header class="mb-12">
        <div class="flex flex-col sm:flex-row gap-6 items-start">
          <img
            src="/apps/me-sense.jpg"
            alt="ME SENSE app icon"
            width="96"
            height="96"
            class="flex-shrink-0 w-24 h-24 rounded-xl border border-gray-200 dark:border-zinc-700"
          />
          <div class="flex-1">
            <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100">
              ME SENSE Mobile App
            </h1>
            <p class="text-gray-600 dark:text-gray-400 mt-1">
              A product by Weatherdock AG
            </p>
            <div
              class="flex flex-wrap gap-4 mt-3 text-sm text-gray-500 dark:text-gray-400"
            >
              <span class="flex items-center gap-1">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="1.5"
                  stroke="currentColor"
                  class="w-4 h-4"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z"
                  ></path>
                </svg>
                Mobile App Developer
              </span>
            </div>
          </div>
        </div>

        <AppStoreLinks
          appStoreUrl="https://apps.apple.com/de/app/me-sense/id1616114697"
        />
      </header>

      <div class="prose lg:prose-lg max-w-none">
        <p>
          ME SENSE is Weatherdock AG's mobile product for keeping an eye on a
          boat while away from it. The app presents measurements collected by
          the ME SENSE system and gives owners a remote view of their vessel on
          a phone or tablet.
        </p>

        <h2>Project overview</h2>
        <p>
          I contributed to the public mobile product and its user-facing
          experience. The work centred on making remote boat information clear
          and useful in everyday situations, while supporting the product as it
          evolved.
        </p>

        <h2>Areas of contribution</h2>
        <ul>
          <li>
            <strong>Remote monitoring experience:</strong> Contributed to the app
            experience through which owners review current information about their
            boat away from the marina or winter storage.
          </li>
          <li>
            <strong>Sensor information:</strong> Worked on user-facing flows that
            make readings from the ME SENSE product family understandable on mobile
            devices.
          </li>
          <li>
            <strong>Alerts and status awareness:</strong> Supported interactions
            around thresholds and notifications so relevant changes can be brought
            to the owner's attention.
          </li>
          <li>
            <strong>Product evolution:</strong> Contributed to the ongoing quality
            and usability of the iPhone and iPad app as its publicly available capabilities
            expanded.
          </li>
        </ul>

        <p class="text-sm text-gray-500 dark:text-gray-400">
          This independent case study describes my contribution to the public
          product experience. ME SENSE is a product of Weatherdock AG;
          Weatherdock AG has not sponsored or endorsed this website.
        </p>
      </div>
    </article>

    <Footer />
  </BaseLayout>
</Layout>
