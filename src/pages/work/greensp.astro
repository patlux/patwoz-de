---
import Layout from '~/layouts/Layout.astro'
import BaseLayout from '~/components/BaseLayout.astro'
import Footer from '~/components/Footer.astro'
import AppStoreLinks from '~/components/AppStoreLinks.astro'

const pageTitle = 'GreenSP'
const description =
  'Mobile application work for GreenSP, Ranger’s sales partner app for performance and monthly billing information.'
const canonicalURL = new URL(Astro.url.pathname, Astro.site)
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: Astro.site?.toString() || 'https://patwoz.dev',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Work',
      item: new URL('/work', Astro.site).toString(),
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: pageTitle,
      item: canonicalURL.toString(),
    },
  ],
}
---

<Layout
  title="Ranger / GreenSP - Work"
  description={description}
  image="https://patwoz.dev/apps/greensp.png"
>
  <BaseLayout>
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(breadcrumbSchema)}
    />
    <article class="mt-12">
      <a
        href="/work"
        class="inline-flex items-center gap-1 text-sm text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-300 mb-6"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
          class="w-4 h-4"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M15.75 19.5 8.25 12l7.5-7.5"></path>
        </svg>
        Back to Work
      </a>

      <header class="mb-12">
        <div class="flex flex-col sm:flex-row gap-6 items-start">
          <div
            class="flex-shrink-0 flex items-center justify-center w-24 h-24 bg-gray-50 dark:bg-zinc-800 rounded-xl border border-gray-200 dark:border-zinc-700"
          >
            <img
              src="/apps/greensp.png"
              alt="GreenSP app icon"
              width="80"
              height="80"
              class="rounded-xl"
            />
          </div>
          <div class="flex-1">
            <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100">
              GreenSP Mobile App
            </h1>
            <p class="text-gray-600 dark:text-gray-400 mt-1">
              Ranger sales partner application
            </p>
            <div
              class="flex flex-wrap gap-4 mt-3 text-sm text-gray-500 dark:text-gray-400"
            >
              <span class="flex items-center gap-1">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="1.5"
                  stroke="currentColor"
                  class="w-4 h-4"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z"
                  ></path>
                </svg>
                Mobile App Developer
              </span>
            </div>
          </div>
        </div>

        <AppStoreLinks
          playStoreUrl="https://play.google.com/store/apps/details?id=com.ranger.greensp"
        />
      </header>

      <div class="prose lg:prose-lg max-w-none">
        <p>
          Contributed to GreenSP, a mobile application for Ranger sales
          partners. Ranger is a European direct-sales company focused on
          personal customer consultation, including telecommunications and
          energy products.
        </p>

        <h2>Project overview</h2>
        <p>
          GreenSP gives sales partners a central mobile point of contact for
          information about employee performance, deal performance and monthly
          billing with the Business Power Team. My work supported the publicly
          visible application and its product experience.
        </p>

        <h2>Areas of contribution</h2>
        <ul>
          <li>
            <strong>Mobile product experience:</strong> Contributed to a focused
            application for the day-to-day information needs of Ranger sales partners.
          </li>
          <li>
            <strong>Performance information:</strong> Supported clear access to employee
            and deal performance within the app.
          </li>
          <li>
            <strong>Billing overview:</strong> Worked on the product experience around
            monthly billing information.
          </li>
          <li>
            <strong>Usability and reliability:</strong> Helped refine the app experience,
            including sign-in continuity and general stability.
          </li>
        </ul>
        <p class="text-sm text-gray-500 dark:text-gray-400">
          This summary is intentionally limited to information visible in
          Ranger’s public website and the public Google Play listing. Ranger and
          GreenSP are referenced for project attribution only; no endorsement is
          implied.
        </p>
      </div>
    </article>

    <Footer />
  </BaseLayout>
</Layout>
