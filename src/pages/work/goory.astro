---
import AppStoreLinks from '~/components/AppStoreLinks.astro'
import BaseLayout from '~/components/BaseLayout.astro'
import Footer from '~/components/Footer.astro'
import Layout from '~/layouts/Layout.astro'

const pageTitle = 'Goory'
const description =
  'Built Goory across its mobile app, partner CMS, backend, data layer and delivery infrastructure as a piparo.tech project.'
const canonicalURL = new URL(Astro.url.pathname, Astro.site)
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: Astro.site?.toString() || 'https://patwoz.dev',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Work',
      item: new URL('/work', Astro.site).toString(),
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: pageTitle,
      item: canonicalURL.toString(),
    },
  ],
}
---

<Layout
  title="Goory - Work"
  description={description}
  image="https://patwoz.dev/apps/goory.jpg"
>
  <BaseLayout>
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(breadcrumbSchema)}
    />

    <article class="mt-12">
      <a
        href="/work"
        class="mb-6 inline-flex items-center gap-1 text-sm text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-300"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
          class="h-4 w-4"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M15.75 19.5 8.25 12l7.5-7.5"></path>
        </svg>
        Back to Work
      </a>

      <header class="mb-12">
        <div class="flex flex-col items-start gap-6 sm:flex-row">
          <div
            class="h-24 w-24 flex-shrink-0 overflow-hidden rounded-xl border border-gray-200 bg-gray-50 dark:border-zinc-700 dark:bg-zinc-800"
          >
            <img
              src="/apps/goory.jpg"
              alt="Goory app icon"
              width="96"
              height="96"
              class="h-full w-full object-cover"
            />
          </div>
          <div class="flex-1">
            <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100">
              Goory
            </h1>
            <p class="mt-1 text-gray-600 dark:text-gray-400">
              A Goory product developed by piparo.tech GmbH
            </p>
            <div
              class="mt-3 flex flex-wrap gap-4 text-sm text-gray-500 dark:text-gray-400"
            >
              <span class="flex items-center gap-1">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="1.5"
                  stroke="currentColor"
                  class="h-4 w-4"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z"
                  ></path>
                </svg>
                Full-Stack Software Engineer
              </span>
            </div>
          </div>
        </div>

        <AppStoreLinks
          appStoreUrl="https://apps.apple.com/de/app/goory/id6670455024"
          playStoreUrl="https://play.google.com/store/apps/details?id=tech.piparo.goory"
        />
      </header>

      <div class="prose max-w-none lg:prose-lg">
        <p>
          Goory helps people discover local food and beverage products, the
          businesses behind them and nearby places where they are sold. The app
          combines a visual discovery feed, product information, personal
          preferences and location-based exploration.
        </p>

        <h2>Project overview</h2>
        <p>
          As part of the piparo.tech team, I worked across the product rather
          than on a single isolated surface. My contributions span the Expo and
          React Native app, the partner-facing content management system, the
          Bun-based API and shared data model, as well as build and deployment
          workflows.
        </p>
        <p>
          This end-to-end involvement connected consumer features with the tools
          required by producers and retailers to maintain their profiles,
          products, imagery and points of sale. It also included the less
          visible work needed to make those experiences reliable: migrations,
          caching, validation, image delivery, automated checks and production
          releases.
        </p>

        <h2>Areas of contribution</h2>
        <ul>
          <li>
            <strong>Mobile product foundation:</strong> Set up and evolved the cross-platform
            Expo application, typed routing, navigation, environment handling, styling
            and native build configuration for iOS and Android.
          </li>
          <li>
            <strong>Discovery and product journeys:</strong> Implemented product
            lists and detail views, supplier profiles, preference-based tags, the
            home feed and deep links that take users directly to relevant products
            and suppliers.
          </li>
          <li>
            <strong>Barcode scanning:</strong> Built the camera-based EAN lookup
            flow and its found and not-found states, connecting an everyday physical
            product to the corresponding Goory content.
          </li>
          <li>
            <strong>Nearby exploration:</strong> Developed location-aware maps for
            producers and retail locations, including map clustering, current-location
            controls, permissions and supporting API queries.
          </li>
          <li>
            <strong>Feed performance:</strong> Improved perceived speed and stability
            through local SQLite persistence, debounced queries, global cache policies,
            viewport-aware image prefetching and more efficient image rendering.
          </li>
          <li>
            <strong>Mobile interaction quality:</strong> Added swipeable home sections
            and an animated tab indicator, while resolving layout, storage and platform-specific
            issues through framework upgrades.
          </li>
          <li>
            <strong>Partner CMS:</strong> Helped establish and extend the Remix administration
            application used to manage organisations, products, tags, assets, opening
            hours and retail locations, with responsive forms and validation.
          </li>
          <li>
            <strong>Backend and data model:</strong> Implemented typed API routes
            for products, suppliers, tags, feed content, nearby places and retail
            locations, together with database schemas, migrations and asset handling.
          </li>
          <li>
            <strong>Quality and delivery:</strong> Added type, lint, formatting and
            backend test checks; maintained local store build and submission workflows;
            and built container-based deployment automation with health verification.
          </li>
        </ul>
        <p class="text-sm text-gray-500 dark:text-gray-400">
          Goory is a collaborative piparo.tech project. The areas above describe
          my evidenced contributions without disclosing private operational or
          customer data.
        </p>
      </div>

      <div class="prose mt-8 max-w-none lg:prose-lg">
        <h2>Technology Stack</h2>
      </div>

      <div class="mb-12 mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        <div>
          <h3
            class="mb-3 text-sm font-semibold uppercase text-gray-500 dark:text-gray-400"
          >
            Mobile
          </h3>
          <ul class="space-y-2">
            <li class="text-gray-700 dark:text-gray-300">React Native</li>
            <li class="text-gray-700 dark:text-gray-300">Expo & Expo Router</li>
            <li class="text-gray-700 dark:text-gray-300">TypeScript</li>
            <li class="text-gray-700 dark:text-gray-300">NativeWind</li>
            <li class="text-gray-700 dark:text-gray-300">React Query</li>
          </ul>
        </div>
        <div>
          <h3
            class="mb-3 text-sm font-semibold uppercase text-gray-500 dark:text-gray-400"
          >
            Web & CMS
          </h3>
          <ul class="space-y-2">
            <li class="text-gray-700 dark:text-gray-300">Remix</li>
            <li class="text-gray-700 dark:text-gray-300">React</li>
            <li class="text-gray-700 dark:text-gray-300">Tailwind CSS</li>
            <li class="text-gray-700 dark:text-gray-300">Radix UI</li>
            <li class="text-gray-700 dark:text-gray-300">Lingui</li>
          </ul>
        </div>
        <div>
          <h3
            class="mb-3 text-sm font-semibold uppercase text-gray-500 dark:text-gray-400"
          >
            Backend & Data
          </h3>
          <ul class="space-y-2">
            <li class="text-gray-700 dark:text-gray-300">Bun</li>
            <li class="text-gray-700 dark:text-gray-300">Elysia</li>
            <li class="text-gray-700 dark:text-gray-300">SQLite</li>
            <li class="text-gray-700 dark:text-gray-300">Drizzle ORM</li>
            <li class="text-gray-700 dark:text-gray-300">TypeBox</li>
          </ul>
        </div>
        <div>
          <h3
            class="mb-3 text-sm font-semibold uppercase text-gray-500 dark:text-gray-400"
          >
            Delivery
          </h3>
          <ul class="space-y-2">
            <li class="text-gray-700 dark:text-gray-300">EAS Build</li>
            <li class="text-gray-700 dark:text-gray-300">GitHub Actions</li>
            <li class="text-gray-700 dark:text-gray-300">Docker & Podman</li>
            <li class="text-gray-700 dark:text-gray-300">Traefik</li>
            <li class="text-gray-700 dark:text-gray-300">
              Automated health checks
            </li>
          </ul>
        </div>
      </div>
    </article>

    <Footer />
  </BaseLayout>
</Layout>
