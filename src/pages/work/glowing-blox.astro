---
import Layout from '~/layouts/Layout.astro'
import AppStoreLinks from '~/components/AppStoreLinks.astro'
import BaseLayout from '~/components/BaseLayout.astro'
import Footer from '~/components/Footer.astro'

const pageTitle = 'Glowing Blox'
const description =
  'Co-created Glowing Blox, a local and online block-strategy game by piparo.tech, spanning mobile, multiplayer, web, testing and releases.'
const canonicalURL = new URL(Astro.url.pathname, Astro.site)
const socialImage = new URL('/apps/glowing-blox.png', Astro.site).toString()
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: Astro.site?.toString() || 'https://patwoz.dev',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Work',
      item: new URL('/work', Astro.site).toString(),
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: pageTitle,
      item: canonicalURL.toString(),
    },
  ],
}
---

<Layout
  title="Glowing Blox - Work"
  description={description}
  image={socialImage}
>
  <BaseLayout>
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(breadcrumbSchema)}
    />
    <article class="mt-12">
      <a
        href="/work"
        class="inline-flex items-center gap-1 text-sm text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-300 mb-6"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
          class="w-4 h-4"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M15.75 19.5 8.25 12l7.5-7.5"></path>
        </svg>
        Back to Work
      </a>

      <header class="mb-12">
        <div class="flex flex-col sm:flex-row gap-6 items-start">
          <div
            class="flex-shrink-0 flex items-center justify-center w-24 h-24 bg-gray-50 dark:bg-zinc-800 rounded-xl border border-gray-200 dark:border-zinc-700 overflow-hidden"
          >
            <img
              src="/apps/glowing-blox.png"
              alt="Glowing Blox app icon"
              width="96"
              height="96"
              class="w-full h-full object-cover"
            />
          </div>
          <div class="flex-1">
            <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100">
              Glowing Blox
            </h1>
            <p class="text-gray-600 dark:text-gray-400 mt-1">
              A piparo.tech GmbH product
            </p>
            <div
              class="flex flex-wrap gap-4 mt-3 text-sm text-gray-500 dark:text-gray-400"
            >
              <span class="flex items-center gap-1">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="1.5"
                  stroke="currentColor"
                  class="w-4 h-4"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z"
                  ></path>
                </svg>
                Co-creator &amp; Full-stack Product Engineer
              </span>
            </div>
          </div>
        </div>

        <AppStoreLinks
          appStoreUrl="https://apps.apple.com/us/app/glowing-blox/id1610502186"
          playStoreUrl="https://play.google.com/store/apps/details?id=tech.piparo.glowingblox"
        />
      </header>

      <div class="prose lg:prose-lg max-w-none">
        <p>
          Glowing Blox is a turn-based block-strategy game created by
          piparo.tech. Two players place and rotate shapes on a shared board,
          trying to leave their opponent without a valid move. It can be played
          locally on one device, online with friends, or against a computer
          opponent.
        </p>

        <h2>Project overview</h2>
        <p>
          I helped shape the product from its first Expo prototype into a
          released iOS and Android game. My work spans the touch-first mobile
          experience, the shared rules engine, online multiplayer, backend
          services, the public website, automated testing, and release
          workflows. The product was developed collaboratively at piparo.tech;
          the areas below describe my concrete engineering contributions.
        </p>
        <p>
          A central challenge was keeping a spatial board game immediate on a
          small touchscreen while ensuring that local and networked matches
          follow the same deterministic rules. The architecture therefore shares
          game logic across clients and server, while the interface gives
          players clear feedback about placement validity, turn ownership, and
          the next available action.
        </p>

        <h2>Areas of contribution</h2>
        <ul>
          <li>
            <strong>Product foundation:</strong> Set up the original Expo app, navigation,
            settings, game state, monorepo structure, validation, and continuous
            integration that became the foundation of the released product.
          </li>
          <li>
            <strong>Touch-first board controls:</strong> Built and refined direct
            manipulation for moving and rotating pieces through taps and drag gestures,
            with an optional directional control for players who prefer explicit
            buttons.
          </li>
          <li>
            <strong>Game engine:</strong> Extracted the rules and state transitions
            into a shared TypeScript engine, added deterministic game tests, and
            kept client and server behavior aligned as the game evolved.
          </li>
          <li>
            <strong>Local play and computer opponents:</strong> Developed configurable
            offline matches on one device and added bot opponents, including a stronger
            expert difficulty for solo play.
          </li>
          <li>
            <strong>Online multiplayer:</strong> Implemented lobby creation and joining,
            shareable invitations, synchronized turns, reconnect behavior, player
            presence, rematches, and lightweight reactions between opponents.
          </li>
          <li>
            <strong>Authoritative backend:</strong> Built and hardened the Go game
            server and its real-time protocol so that online actions are validated,
            persisted, and distributed from one authoritative game state.
          </li>
          <li>
            <strong>Player continuity:</strong> Added deep links and turn notifications,
            supported several concurrent matches, and integrated platform game services
            for familiar player names without making sign-in a requirement for play.
          </li>
          <li>
            <strong>Interface feedback:</strong> Improved turn headers, invalid-placement
            guidance, modal transitions, winner presentation, offline states, responsive
            screen layouts, and visual effects that make successful moves feel more
            tangible.
          </li>
          <li>
            <strong>Quality and release engineering:</strong> Established unit, integration,
            race, real-device handoff, fault, and soak checks; maintained mobile
            builds and store submission; and developed staged release and rollback
            safeguards for multiplayer changes.
          </li>
          <li>
            <strong>Public product website:</strong> Evolved the game's website to
            Astro and maintained the product explanation, game instructions, store
            entry points, and deployment workflow.
          </li>
        </ul>
      </div>

      <div class="prose lg:prose-lg max-w-none mt-8">
        <h2>Technology Stack</h2>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6 mt-6 mb-12">
        <div>
          <h3
            class="text-sm font-semibold text-gray-500 dark:text-gray-400 uppercase mb-3"
          >
            Mobile
          </h3>
          <ul class="space-y-2">
            <li class="text-gray-700 dark:text-gray-300">React Native</li>
            <li class="text-gray-700 dark:text-gray-300">Expo</li>
            <li class="text-gray-700 dark:text-gray-300">TypeScript</li>
            <li class="text-gray-700 dark:text-gray-300">React Navigation</li>
            <li class="text-gray-700 dark:text-gray-300">React Native Skia</li>
          </ul>
        </div>
        <div>
          <h3
            class="text-sm font-semibold text-gray-500 dark:text-gray-400 uppercase mb-3"
          >
            Game &amp; Multiplayer
          </h3>
          <ul class="space-y-2">
            <li class="text-gray-700 dark:text-gray-300">
              Shared TypeScript engine
            </li>
            <li class="text-gray-700 dark:text-gray-300">WebSockets</li>
            <li class="text-gray-700 dark:text-gray-300">Apple Game Center</li>
            <li class="text-gray-700 dark:text-gray-300">Google Play Games</li>
          </ul>
        </div>
        <div>
          <h3
            class="text-sm font-semibold text-gray-500 dark:text-gray-400 uppercase mb-3"
          >
            Backend &amp; Web
          </h3>
          <ul class="space-y-2">
            <li class="text-gray-700 dark:text-gray-300">Go</li>
            <li class="text-gray-700 dark:text-gray-300">SQLite</li>
            <li class="text-gray-700 dark:text-gray-300">Astro</li>
            <li class="text-gray-700 dark:text-gray-300">Tailwind CSS</li>
          </ul>
        </div>
        <div>
          <h3
            class="text-sm font-semibold text-gray-500 dark:text-gray-400 uppercase mb-3"
          >
            Delivery &amp; Quality
          </h3>
          <ul class="space-y-2">
            <li class="text-gray-700 dark:text-gray-300">
              Bun &amp; Turborepo
            </li>
            <li class="text-gray-700 dark:text-gray-300">EAS Build</li>
            <li class="text-gray-700 dark:text-gray-300">GitHub Actions</li>
            <li class="text-gray-700 dark:text-gray-300">
              Integration &amp; soak testing
            </li>
          </ul>
        </div>
      </div>
    </article>

    <Footer />
  </BaseLayout>
</Layout>
