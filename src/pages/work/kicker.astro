---
import Layout from '~/layouts/Layout.astro'
import BaseLayout from '~/components/BaseLayout.astro'
import Footer from '~/components/Footer.astro'
import AppStoreLinks from '~/components/AppStoreLinks.astro'

const pageTitle = 'Kicker'
const description =
  'End-to-end platform work for the Kicker streaming app, backend services, and Kubernetes infrastructure.'
const canonicalURL = new URL(Astro.url.pathname, Astro.site)
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: Astro.site?.toString() || 'https://patwoz.dev',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Work',
      item: new URL('/work', Astro.site).toString(),
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: pageTitle,
      item: canonicalURL.toString(),
    },
  ],
}
---

<Layout title="Olympia Verlag (Kicker) - Work" description={description}>
  <BaseLayout>
    <script
      type="application/ld+json"
      set:html={JSON.stringify(breadcrumbSchema)}
    />
    <article>
      <!-- Back link -->
      <a
        href="/work"
        class="inline-flex items-center gap-1 text-sm text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-300 mb-6"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
          class="w-4 h-4"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M15.75 19.5 8.25 12l7.5-7.5"></path>
        </svg>
        Back to Work
      </a>

      <!-- Header -->
      <header class="mb-12">
        <div class="flex flex-col sm:flex-row gap-6 items-start">
          <div
            class="flex-shrink-0 flex items-center justify-center w-24 h-24 bg-gray-50 dark:bg-zinc-800 rounded-xl border border-gray-200 dark:border-zinc-700"
            data-vt-hero="logo"
          >
            <img
              src="/company/kicker.svg"
              alt="Kicker Logo"
              width="70"
              height="28"
            />
          </div>
          <div class="flex-1">
            <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100">
              FWMFL - Football Was My First Love
            </h1>
            <p class="text-gray-600 dark:text-gray-400 mt-1">
              Olympia Verlag (Kicker)
            </p>
            <div
              class="flex flex-wrap gap-4 mt-3 text-sm text-gray-500 dark:text-gray-400"
            >
              <span class="flex items-center gap-1">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="1.5"
                  stroke="currentColor"
                  class="w-4 h-4"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z"
                  ></path>
                </svg>
                Lead Fullstack Developer
              </span>
              <span class="flex items-center gap-1">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="1.5"
                  stroke="currentColor"
                  class="w-4 h-4"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21M3 3h12m-.75 4.5H21m-3.75 3.75h.008v.008h-.008v-.008Zm0 3h.008v.008h-.008v-.008Zm0 3h.008v.008h-.008v-.008Z"
                  ></path>
                </svg>
                via piparo.tech
              </span>
            </div>
          </div>
        </div>

        <AppStoreLinks
          appStoreUrl="https://apps.apple.com/de/app/football-was-my-first-love/id1476249064"
          playStoreUrl="https://play.google.com/store/apps/details?id=com.fbwmfl.de"
        />
      </header>

      <!-- Content -->
      <div class="prose lg:prose-lg max-w-none">
        <p>
          Contributed (via piparo.tech) to FWMFL — Football Was My First Love —
          a podcast and audiobook streaming platform for football fans,
          published by Olympia-Verlag (Kicker).
        </p>

        <h2>Areas of contribution</h2>
        <ul>
          <li>
            <strong>Mobile app:</strong> React Native + Expo app for audio streaming
            with background playback, offline downloads, subscriptions and push.
          </li>
          <li>
            <strong>Audio player:</strong> Queue management, playback progress and
            seamless transitions; offline mode with local storage.
          </li>
          <li>
            <strong>Subscriptions & monetisation:</strong> In-app purchase flows,
            paywall UI, supporter recognition and premium-content gating.
          </li>
          <li>
            <strong>Backend services:</strong> Services in Go and Rust for API endpoints,
            content management and RSS ingestion.
          </li>
          <li>
            <strong>Marketing website:</strong> Statically generated site with SEO,
            podcast/audiobook pages and FAQ.
          </li>
          <li>
            <strong>Infrastructure:</strong> Kubernetes platform with Helm and Terraform;
            deployment and local-dev tooling.
          </li>
          <li>
            <strong>Quality:</strong> Accessibility improvements across key flows
            and comprehensive error monitoring.
          </li>
          <li>
            <strong>Modernisation:</strong> Migration of a legacy stack to a consolidated,
            container-orchestrated platform and a port of the mobile app from a hybrid
            framework to React Native.
          </li>
        </ul>
        <p class="text-sm text-gray-500 dark:text-gray-400">
          Internal implementation details and vendor choices of the client
          remain confidential. The list below covers general technologies I
          worked with on this engagement.
        </p>
      </div>

      <div class="prose lg:prose-lg max-w-none mt-8">
        <h2>Technology Stack</h2>
      </div>

      <!-- Tech Stack Grid -->
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6 mt-6 mb-12">
        <div>
          <h4
            class="text-sm font-semibold text-gray-500 dark:text-gray-400 uppercase mb-3"
          >
            Mobile
          </h4>
          <ul class="space-y-2">
            <li class="text-gray-700 dark:text-gray-300">React Native 0.79</li>
            <li class="text-gray-700 dark:text-gray-300">Expo 53</li>
            <li class="text-gray-700 dark:text-gray-300">TypeScript</li>
            <li class="text-gray-700 dark:text-gray-300">NativeWind</li>
            <li class="text-gray-700 dark:text-gray-300">Zustand</li>
            <li class="text-gray-700 dark:text-gray-300">React Query</li>
          </ul>
        </div>
        <div>
          <h4
            class="text-sm font-semibold text-gray-500 dark:text-gray-400 uppercase mb-3"
          >
            Backend
          </h4>
          <ul class="space-y-2">
            <li class="text-gray-700 dark:text-gray-300">Go</li>
            <li class="text-gray-700 dark:text-gray-300">Rust</li>
            <li class="text-gray-700 dark:text-gray-300">MySQL</li>
            <li class="text-gray-700 dark:text-gray-300">SQLite (mobile)</li>
            <li class="text-gray-700 dark:text-gray-300">Laravel (legacy)</li>
          </ul>
        </div>
        <div>
          <h4
            class="text-sm font-semibold text-gray-500 dark:text-gray-400 uppercase mb-3"
          >
            Web
          </h4>
          <ul class="space-y-2">
            <li class="text-gray-700 dark:text-gray-300">Astro</li>
            <li class="text-gray-700 dark:text-gray-300">Tailwind CSS</li>
            <li class="text-gray-700 dark:text-gray-300">TypeScript</li>
          </ul>
        </div>
        <div>
          <h4
            class="text-sm font-semibold text-gray-500 dark:text-gray-400 uppercase mb-3"
          >
            Infrastructure
          </h4>
          <ul class="space-y-2">
            <li class="text-gray-700 dark:text-gray-300">Kubernetes</li>
            <li class="text-gray-700 dark:text-gray-300">Helm</li>
            <li class="text-gray-700 dark:text-gray-300">Terraform</li>
            <li class="text-gray-700 dark:text-gray-300">Docker</li>
            <li class="text-gray-700 dark:text-gray-300">Tilt / Skaffold</li>
          </ul>
        </div>
      </div>
    </article>

    <Footer />
  </BaseLayout>
</Layout>
