---
import Layout from '~/layouts/Layout.astro'
import BaseLayout from '~/components/BaseLayout.astro'
import Footer from '~/components/Footer.astro'
import ClientMarquee from '~/components/ClientMarquee.astro'

const appCaseStudies = [
  {
    name: 'Glowing Blox',
    href: '/work/glowing-blox',
    icon: '/apps/glowing-blox.png',
    description:
      'A local and online strategy game built across mobile, multiplayer, backend and web.',
  },
  {
    name: 'Goory',
    href: '/work/goory',
    icon: '/apps/goory.jpg',
    description:
      'A local-product discovery platform spanning mobile, CMS, backend and delivery.',
  },
  {
    name: 'Yuu Yoga',
    href: '/work/yuuyoga',
    icon: '/apps/yuu-yoga.jpg',
    description:
      'Mobile product work for Porsche Digital’s guided yoga experience.',
  },
  {
    name: 'GreenSP',
    href: '/work/greensp',
    icon: '/apps/greensp.png',
    description:
      'A focused mobile information product for Ranger sales partners.',
  },
  {
    name: 'ME SENSE',
    href: '/work/me-sense',
    icon: '/apps/me-sense.jpg',
    description:
      'The Weatherdock mobile experience for remote boat monitoring.',
  },
]
---

<Layout
  title="Work"
  description="Client work, own products, and project highlights across mobile, web, and platform engineering."
>
  <BaseLayout>
    <section class="animate-fade-in-up opacity-0">
      <h1
        class="text-3xl sm:text-4xl font-display font-bold text-warm-900 dark:text-warm-100"
      >
        Client Work
      </h1>
      <p class="text-lg text-warm-600 dark:text-warm-400 mt-3 leading-relaxed">
        Selected client work and products I've helped build. Each project
        highlights a different part of my mobile, web, and platform engineering
        experience.
      </p>
    </section>

    <div class="grid gap-5 mt-10">
      <!-- piparo.party -->
      <a
        href="/work/piparo-party"
        class="card-soft p-6 group hover-lift animate-fade-in-up opacity-0 stagger-1"
      >
        <div class="flex flex-col sm:flex-row gap-6">
          <div
            class="flex-shrink-0 flex items-center justify-center w-full sm:w-32 h-24 bg-[#15172a] rounded-xl transition-colors"
          >
            <img
              src="/company/piparo-party.webp"
              alt="piparo.party app icon"
              width="72"
              height="72"
              class="rounded-xl"
            />
          </div>
          <div class="flex-1">
            <h3
              class="text-lg font-semibold text-warm-900 dark:text-warm-100 group-hover:text-accent-600 dark:group-hover:text-accent-400 transition-colors"
            >
              piparo.party
            </h3>
            <p class="text-warm-600 dark:text-warm-400 mt-2 leading-relaxed">
              Built an offline-first party-game product with 25 games, 22
              languages, native subscriptions, a multilingual website and a
              growing local multiplayer platform.
            </p>
            <div class="flex flex-wrap gap-2 mt-4">
              <span
                class="px-2.5 py-1 text-xs font-medium bg-warm-200 dark:bg-warm-800/40 text-warm-700 dark:text-warm-300 rounded-lg"
              >
                React Native
              </span>
              <span
                class="px-2.5 py-1 text-xs font-medium bg-warm-200 dark:bg-warm-800/40 text-warm-700 dark:text-warm-300 rounded-lg"
              >
                Expo
              </span>
              <span
                class="px-2.5 py-1 text-xs font-medium bg-warm-200 dark:bg-warm-800/40 text-warm-700 dark:text-warm-300 rounded-lg"
              >
                TypeScript
              </span>
              <span
                class="px-2.5 py-1 text-xs font-medium bg-warm-200 dark:bg-warm-800/40 text-warm-700 dark:text-warm-300 rounded-lg"
              >
                Product Development
              </span>
            </div>
          </div>
          <div
            class="flex-shrink-0 flex items-center text-warm-400 group-hover:text-accent-500 transition-colors"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="2"
              stroke="currentColor"
              class="w-5 h-5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="m8.25 4.5 7.5 7.5-7.5 7.5"></path>
            </svg>
          </div>
        </div>
      </a>

      <!-- Porsche Digital -->
      <a
        href="/work/porsche"
        class="card-soft p-6 group hover-lift animate-fade-in-up opacity-0 stagger-2"
      >
        <div class="flex flex-col sm:flex-row gap-6">
          <div
            class="flex-shrink-0 flex items-center justify-center w-full sm:w-32 h-24 bg-warm-100 dark:bg-dark-elevated rounded-xl group-hover:bg-warm-200 dark:group-hover:bg-warm-800/30 transition-colors"
          >
            <img
              src="/company/Porsche-Logo.webp"
              alt="Porsche Logo"
              width="80"
              height="46"
              class="opacity-90"
            />
          </div>
          <div class="flex-1">
            <h3
              class="text-lg font-semibold text-warm-900 dark:text-warm-100 group-hover:text-accent-600 dark:group-hover:text-accent-400 transition-colors"
            >
              Porsche Digital
            </h3>
            <p class="text-warm-600 dark:text-warm-400 mt-2 leading-relaxed">
              Fullstack contributions to a consumer-facing mobile app with
              real-time video, in-app subscriptions, and a serverless AWS
              backend.
            </p>
            <div class="flex flex-wrap gap-2 mt-4">
              <span
                class="px-2.5 py-1 text-xs font-medium bg-warm-200 dark:bg-warm-800/40 text-warm-700 dark:text-warm-300 rounded-lg"
              >
                React Native
              </span>
              <span
                class="px-2.5 py-1 text-xs font-medium bg-warm-200 dark:bg-warm-800/40 text-warm-700 dark:text-warm-300 rounded-lg"
              >
                AWS CDK
              </span>
              <span
                class="px-2.5 py-1 text-xs font-medium bg-warm-200 dark:bg-warm-800/40 text-warm-700 dark:text-warm-300 rounded-lg"
              >
                TypeScript
              </span>
              <span
                class="px-2.5 py-1 text-xs font-medium bg-warm-200 dark:bg-warm-800/40 text-warm-700 dark:text-warm-300 rounded-lg"
              >
                Fullstack
              </span>
            </div>
          </div>
          <div
            class="flex-shrink-0 flex items-center text-warm-400 group-hover:text-accent-500 transition-colors"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="2"
              stroke="currentColor"
              class="w-5 h-5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="m8.25 4.5 7.5 7.5-7.5 7.5"></path>
            </svg>
          </div>
        </div>
      </a>

      <!-- SAP KulturPass -->
      <a
        href="/work/kulturpass"
        class="card-soft p-6 group hover-lift animate-fade-in-up opacity-0 stagger-3"
      >
        <div class="flex flex-col sm:flex-row gap-6">
          <div
            class="flex-shrink-0 flex items-center justify-center w-full sm:w-32 h-24 bg-warm-100 dark:bg-dark-elevated rounded-xl group-hover:bg-warm-200 dark:group-hover:bg-warm-800/30 transition-colors"
          >
            <img
              src="/company/sap.svg"
              alt="SAP Logo"
              width="80"
              height="40"
              class="opacity-90"
            />
          </div>
          <div class="flex-1">
            <h3
              class="text-lg font-semibold text-warm-900 dark:text-warm-100 group-hover:text-accent-600 dark:group-hover:text-accent-400 transition-colors"
            >
              SAP / KulturPass DE
            </h3>
            <p class="text-warm-600 dark:text-warm-400 mt-2 leading-relaxed">
              Contributed to the KulturPass mobile app, a German government
              initiative providing 18-year-olds with a cultural budget.
            </p>
            <div class="flex flex-wrap gap-2 mt-4">
              <span
                class="px-2.5 py-1 text-xs font-medium bg-warm-200 dark:bg-warm-800/40 text-warm-700 dark:text-warm-300 rounded-lg"
              >
                React Native
              </span>
              <span
                class="px-2.5 py-1 text-xs font-medium bg-warm-200 dark:bg-warm-800/40 text-warm-700 dark:text-warm-300 rounded-lg"
              >
                Redux Toolkit
              </span>
              <span
                class="px-2.5 py-1 text-xs font-medium bg-warm-200 dark:bg-warm-800/40 text-warm-700 dark:text-warm-300 rounded-lg"
              >
                TypeScript
              </span>
              <span
                class="px-2.5 py-1 text-xs font-medium bg-warm-200 dark:bg-warm-800/40 text-warm-700 dark:text-warm-300 rounded-lg"
              >
                DevOps
              </span>
            </div>
          </div>
          <div
            class="flex-shrink-0 flex items-center text-warm-400 group-hover:text-accent-500 transition-colors"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="2"
              stroke="currentColor"
              class="w-5 h-5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="m8.25 4.5 7.5 7.5-7.5 7.5"></path>
            </svg>
          </div>
        </div>
      </a>

      <!-- Stroeer / t-online -->
      <a
        href="/work/stroeer"
        class="card-soft p-6 group hover-lift animate-fade-in-up opacity-0 stagger-4"
      >
        <div class="flex flex-col sm:flex-row gap-6">
          <div
            class="flex-shrink-0 flex items-center justify-center w-full sm:w-32 h-24 bg-warm-100 dark:bg-dark-elevated rounded-xl group-hover:bg-warm-200 dark:group-hover:bg-warm-800/30 transition-colors"
          >
            <div class="flex flex-col items-center gap-1">
              <img
                src="/company/str-logo-white.svg"
                alt="Stroeer Logo"
                width="80"
                height="17"
                class="opacity-90 dark:invert"
              />
              <img
                src="/company/t-online-desktop.327ab976.svg"
                alt="t-online Logo"
                width="60"
                height="13"
                class="opacity-90 dark:invert"
              />
            </div>
          </div>
          <div class="flex-1">
            <h3
              class="text-lg font-semibold text-warm-900 dark:text-warm-100 group-hover:text-accent-600 dark:group-hover:text-accent-400 transition-colors"
            >
              Stroeer / t-online
            </h3>
            <p class="text-warm-600 dark:text-warm-400 mt-2 leading-relaxed">
              Contributed to the t-online news mobile app, built on React Native
              and Expo, across navigation, search, push notifications and
              monetization.
            </p>
            <div class="flex flex-wrap gap-2 mt-4">
              <span
                class="px-2.5 py-1 text-xs font-medium bg-warm-200 dark:bg-warm-800/40 text-warm-700 dark:text-warm-300 rounded-lg"
              >
                React Native
              </span>
              <span
                class="px-2.5 py-1 text-xs font-medium bg-warm-200 dark:bg-warm-800/40 text-warm-700 dark:text-warm-300 rounded-lg"
              >
                Expo
              </span>
              <span
                class="px-2.5 py-1 text-xs font-medium bg-warm-200 dark:bg-warm-800/40 text-warm-700 dark:text-warm-300 rounded-lg"
              >
                TypeScript
              </span>
              <span
                class="px-2.5 py-1 text-xs font-medium bg-warm-200 dark:bg-warm-800/40 text-warm-700 dark:text-warm-300 rounded-lg"
              >
                DevOps
              </span>
            </div>
          </div>
          <div
            class="flex-shrink-0 flex items-center text-warm-400 group-hover:text-accent-500 transition-colors"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="2"
              stroke="currentColor"
              class="w-5 h-5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="m8.25 4.5 7.5 7.5-7.5 7.5"></path>
            </svg>
          </div>
        </div>
      </a>

      <!-- ABL -->
      <a
        href="/work/abl"
        class="card-soft p-6 group hover-lift animate-fade-in-up opacity-0 stagger-5"
      >
        <div class="flex flex-col sm:flex-row gap-6">
          <div
            class="flex-shrink-0 flex items-center justify-center w-full sm:w-32 h-24 bg-warm-100 dark:bg-dark-elevated rounded-xl group-hover:bg-warm-200 dark:group-hover:bg-warm-800/30 transition-colors"
          >
            <img
              src="/company/abl.svg"
              alt="ABL Logo"
              width="80"
              height="32"
              class="opacity-90 dark:invert"
            />
          </div>
          <div class="flex-1">
            <h3
              class="text-lg font-semibold text-warm-900 dark:text-warm-100 group-hover:text-accent-600 dark:group-hover:text-accent-400 transition-colors"
            >
              ABL
            </h3>
            <p class="text-warm-600 dark:text-warm-400 mt-2 leading-relaxed">
              Contributed to the ABL Configuration App for EV wallbox setup and
              management, including device communication over WiFi/Bluetooth,
              firmware updates and multi-language support.
            </p>
            <div class="flex flex-wrap gap-2 mt-4">
              <span
                class="px-2.5 py-1 text-xs font-medium bg-warm-200 dark:bg-warm-800/40 text-warm-700 dark:text-warm-300 rounded-lg"
              >
                React Native
              </span>
              <span
                class="px-2.5 py-1 text-xs font-medium bg-warm-200 dark:bg-warm-800/40 text-warm-700 dark:text-warm-300 rounded-lg"
              >
                MobX
              </span>
              <span
                class="px-2.5 py-1 text-xs font-medium bg-warm-200 dark:bg-warm-800/40 text-warm-700 dark:text-warm-300 rounded-lg"
              >
                TypeScript
              </span>
              <span
                class="px-2.5 py-1 text-xs font-medium bg-warm-200 dark:bg-warm-800/40 text-warm-700 dark:text-warm-300 rounded-lg"
              >
                IoT
              </span>
            </div>
          </div>
          <div
            class="flex-shrink-0 flex items-center text-warm-400 group-hover:text-accent-500 transition-colors"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="2"
              stroke="currentColor"
              class="w-5 h-5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="m8.25 4.5 7.5 7.5-7.5 7.5"></path>
            </svg>
          </div>
        </div>
      </a>

      <!-- IBM / Barmer -->
      <a
        href="/work/ibm"
        class="card-soft p-6 group hover-lift animate-fade-in-up opacity-0 stagger-6"
      >
        <div class="flex flex-col sm:flex-row gap-6">
          <div
            class="flex-shrink-0 flex items-center justify-center w-full sm:w-32 h-24 bg-warm-100 dark:bg-dark-elevated rounded-xl group-hover:bg-warm-200 dark:group-hover:bg-warm-800/30 transition-colors"
          >
            <div class="flex flex-col items-center gap-2">
              <img
                src="/company/IBM_logo.svg"
                alt="IBM Logo"
                width="50"
                height="20"
                class="opacity-90"
              />
              <img
                src="/company/barmer.svg"
                alt="Barmer Logo"
                width="60"
                height="16"
                class="opacity-90"
              />
            </div>
          </div>
          <div class="flex-1">
            <h3
              class="text-lg font-semibold text-warm-900 dark:text-warm-100 group-hover:text-accent-600 dark:group-hover:text-accent-400 transition-colors"
            >
              IBM iX / Barmer
            </h3>
            <p class="text-warm-600 dark:text-warm-400 mt-2 leading-relaxed">
              Frontend work via IBM iX for Barmer, one of Germany's largest
              health insurers, including contributions to modules of the Barmer
              App and a cross-platform design system.
            </p>
            <div class="flex flex-wrap gap-2 mt-4">
              <span
                class="px-2.5 py-1 text-xs font-medium bg-warm-200 dark:bg-warm-800/40 text-warm-700 dark:text-warm-300 rounded-lg"
              >
                React Native
              </span>
              <span
                class="px-2.5 py-1 text-xs font-medium bg-warm-200 dark:bg-warm-800/40 text-warm-700 dark:text-warm-300 rounded-lg"
              >
                React
              </span>
              <span
                class="px-2.5 py-1 text-xs font-medium bg-warm-200 dark:bg-warm-800/40 text-warm-700 dark:text-warm-300 rounded-lg"
              >
                TypeScript
              </span>
              <span
                class="px-2.5 py-1 text-xs font-medium bg-warm-200 dark:bg-warm-800/40 text-warm-700 dark:text-warm-300 rounded-lg"
              >
                Design System
              </span>
            </div>
          </div>
          <div
            class="flex-shrink-0 flex items-center text-warm-400 group-hover:text-accent-500 transition-colors"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="2"
              stroke="currentColor"
              class="w-5 h-5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="m8.25 4.5 7.5 7.5-7.5 7.5"></path>
            </svg>
          </div>
        </div>
      </a>

      <!-- Olympia Verlag / Kicker -->
      <a
        href="/work/kicker"
        class="card-soft p-6 group hover-lift animate-fade-in-up opacity-0 stagger-6"
      >
        <div class="flex flex-col sm:flex-row gap-6">
          <div
            class="flex-shrink-0 flex items-center justify-center w-full sm:w-32 h-24 bg-warm-100 dark:bg-dark-elevated rounded-xl group-hover:bg-warm-200 dark:group-hover:bg-warm-800/30 transition-colors"
          >
            <img
              src="/company/kicker.svg"
              alt="Kicker Logo"
              width="80"
              height="32"
              class="opacity-90"
            />
          </div>
          <div class="flex-1">
            <h3
              class="text-lg font-semibold text-warm-900 dark:text-warm-100 group-hover:text-accent-600 dark:group-hover:text-accent-400 transition-colors"
            >
              Olympia Verlag (Kicker)
            </h3>
            <p class="text-warm-600 dark:text-warm-400 mt-2 leading-relaxed">
              Fullstack contributions to FWMFL, a podcast and audiobook
              streaming platform for football fans, spanning mobile, backend
              services, website and Kubernetes infrastructure.
            </p>
            <div class="flex flex-wrap gap-2 mt-4">
              <span
                class="px-2.5 py-1 text-xs font-medium bg-warm-200 dark:bg-warm-800/40 text-warm-700 dark:text-warm-300 rounded-lg"
              >
                React Native
              </span>
              <span
                class="px-2.5 py-1 text-xs font-medium bg-warm-200 dark:bg-warm-800/40 text-warm-700 dark:text-warm-300 rounded-lg"
              >
                Go / Rust
              </span>
              <span
                class="px-2.5 py-1 text-xs font-medium bg-warm-200 dark:bg-warm-800/40 text-warm-700 dark:text-warm-300 rounded-lg"
              >
                Kubernetes
              </span>
              <span
                class="px-2.5 py-1 text-xs font-medium bg-warm-200 dark:bg-warm-800/40 text-warm-700 dark:text-warm-300 rounded-lg"
              >
                Fullstack
              </span>
            </div>
          </div>
          <div
            class="flex-shrink-0 flex items-center text-warm-400 group-hover:text-accent-500 transition-colors"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="2"
              stroke="currentColor"
              class="w-5 h-5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="m8.25 4.5 7.5 7.5-7.5 7.5"></path>
            </svg>
          </div>
        </div>
      </a>
    </div>

    <section class="mt-16 animate-fade-in-up opacity-0 stagger-6">
      <div class="max-w-2xl">
        <h2
          class="text-2xl font-display font-bold text-warm-900 dark:text-warm-100"
        >
          More App Case Studies
        </h2>
        <p class="mt-2 text-warm-600 dark:text-warm-400 leading-relaxed">
          Additional mobile products, from piparo.tech ventures to focused
          client engagements.
        </p>
      </div>

      <div
        class="mt-6 overflow-hidden rounded-lg border border-warm-200 bg-white dark:border-warm-800 dark:bg-dark-surface"
      >
        {
          appCaseStudies.map((project) => (
            <a
              href={project.href}
              class="ledger-hover-cell flex min-h-28 items-center gap-4 border-b border-warm-200 p-5 last:border-b-0 dark:border-warm-800"
            >
              <img
                src={project.icon}
                alt={`${project.name} app icon`}
                width="64"
                height="64"
                class="h-16 w-16 flex-shrink-0 rounded-xl object-cover ring-1 ring-black/10 dark:ring-white/10"
              />
              <span class="min-w-0 flex-1">
                <span class="block font-semibold text-warm-900 dark:text-warm-100">
                  {project.name}
                </span>
                <span class="mt-1 block text-sm leading-relaxed text-warm-600 dark:text-warm-400">
                  {project.description}
                </span>
              </span>
              <span
                aria-hidden="true"
                class="ledger-hover-arrow text-warm-400 dark:text-warm-500"
              >
                →
              </span>
            </a>
          ))
        }
      </div>
    </section>

    <ClientMarquee />

    <Footer />
  </BaseLayout>
</Layout>
